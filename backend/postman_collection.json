{
  "info": {
    "name": "Fundsroom Mini ERP + CRM API",
    "description": "REST API for the Fundsroom Mini ERP + CRM Operations Portal (Express + PostgreSQL reference implementation).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "challanId", "value": "" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success) pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fundsroom.test\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Register user (ADMIN only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Sales Rep\",\n  \"email\": \"rep@fundsroom.test\",\n  \"password\": \"Sales@1234\",\n  \"role\": \"SALES\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        { "name": "Current user", "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" } }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10&search=&status=ALL&customer_type=ALL",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "status", "value": "ALL" },
                { "key": "customer_type", "value": "ALL" }
              ]
            }
          }
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Rahul Mehta\",\n  \"mobile_number\": \"9876543210\",\n  \"email\": \"rahul@example.com\",\n  \"business_name\": \"Mehta Traders\",\n  \"gst_number\": \"27ABCDE1234F1Z5\",\n  \"customer_type\": \"WHOLESALE\",\n  \"status\": \"ACTIVE\",\n  \"address\": \"Pune, Maharashtra\",\n  \"notes\": \"Interested in bulk orders\"\n}"
            },
            "url": "{{baseUrl}}/customers"
          }
        },
        { "name": "Get customer", "request": { "method": "GET", "url": "{{baseUrl}}/customers/{{customerId}}" } },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Rahul Mehta\",\n  \"mobile_number\": \"9876543210\",\n  \"customer_type\": \"DISTRIBUTOR\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/customers/{{customerId}}"
          }
        },
        {
          "name": "Add follow-up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Called about pending quotation\",\n  \"follow_up_date\": \"2026-09-15\"\n}"
            },
            "url": "{{baseUrl}}/customers/{{customerId}}/follow-ups"
          }
        },
        {
          "name": "List follow-ups",
          "request": { "method": "GET", "url": "{{baseUrl}}/customers/{{customerId}}/follow-ups" }
        },
        {
          "name": "Delete customer (ADMIN)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/customers/{{customerId}}" }
        }
      ]
    },
    {
      "name": "Products & Inventory",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&search=&category=ALL&lowStockOnly=false",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "category", "value": "ALL" },
                { "key": "lowStockOnly", "value": "false" }
              ]
            }
          }
        },
        { "name": "Low stock products", "request": { "method": "GET", "url": "{{baseUrl}}/products/low-stock" } },
        {
          "name": "Create product (WAREHOUSE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_name\": \"Steel Bearing 6204\",\n  \"sku\": \"SKU-6204\",\n  \"category\": \"Bearings\",\n  \"unit_price\": 250.5,\n  \"current_stock\": 120,\n  \"minimum_stock_quantity\": 20,\n  \"warehouse_location\": \"A-12\"\n}"
            },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "Update product (WAREHOUSE)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"unit_price\": 275,\n  \"minimum_stock_quantity\": 25\n}" },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Adjust stock (WAREHOUSE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 25,\n  \"movement_type\": \"IN\",\n  \"reason\": \"Purchase receipt GRN-1042\"\n}"
            },
            "url": "{{baseUrl}}/products/{{productId}}/stock"
          }
        },
        {
          "name": "Stock movement history",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}/movements" }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "List challans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/challans?page=1&limit=10&status=ALL",
              "host": ["{{baseUrl}}"],
              "path": ["challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "ALL" }
              ]
            }
          }
        },
        {
          "name": "Create draft challan (SALES)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customerId}}\",\n  \"notes\": \"Deliver before Friday\",\n  \"items\": [\n    { \"product_id\": \"{{productId}}\", \"quantity\": 5 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/challans"
          }
        },
        { "name": "Get challan", "request": { "method": "GET", "url": "{{baseUrl}}/challans/{{challanId}}" } },
        {
          "name": "Update draft challan (SALES)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customerId}}\",\n  \"items\": [\n    { \"product_id\": \"{{productId}}\", \"quantity\": 8 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/challans/{{challanId}}"
          }
        },
        {
          "name": "Confirm challan (transactional)",
          "request": { "method": "POST", "url": "{{baseUrl}}/challans/{{challanId}}/confirm" }
        },
        {
          "name": "Confirm again (expect 409)",
          "request": { "method": "POST", "url": "{{baseUrl}}/challans/{{challanId}}/confirm" }
        },
        {
          "name": "Cancel draft challan",
          "request": { "method": "POST", "url": "{{baseUrl}}/challans/{{challanId}}/cancel" }
        }
      ]
    },
    {
      "name": "Dashboard",
      "request": { "method": "GET", "url": "{{baseUrl}}/dashboard" }
    }
  ]
}
